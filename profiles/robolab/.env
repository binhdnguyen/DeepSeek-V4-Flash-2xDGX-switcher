ROBOLAB_CHECKOUT=/path/to/DeepSeek-V4-Flash-DSpark-v026-SM121
ROBOLAB_IMAGE=ghcr.io/r0b0tlab/deepseek-v4-flash-dspark-v026-sm121:v0.26.0-sm121-native-v11
WORKER_HOST=worker-host-or-roce-ip
MASTER_ADDR=head-roce-ip
MASTER_PORT=25000
DSPARK_MODEL_DIR=/path/to/DeepSeek-V4-Flash-0731/snapshot
DSPARK_HEAD_MODEL_DIR=/path/to/DeepSeek-V4-Flash-0731/snapshot
DSPARK_WORKER_MODEL_DIR=/path/to/DeepSeek-V4-Flash-0731/snapshot
HF_CACHE=${HOME}/.cache/huggingface
HEAD_ETH_IF=enp1s0f1np1
WORKER_ETH_IF=enp1s0f1np1
HEAD_IB_HCA=rocep1s0f1
WORKER_IB_HCA=rocep1s0f1
NCCL_IB_GID_INDEX=5
SERVED_MODEL_NAME=deepseek-v4-flash-dspark
ROBOLAB_VERIFY_OUTPUT=/tmp/robolab-runtime-gate.json
