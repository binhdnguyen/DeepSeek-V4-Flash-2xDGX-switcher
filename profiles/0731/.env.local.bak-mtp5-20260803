# Copy this file to .env.dspark in the pinned upstream checkout.

# Cluster
WORKER_HOST=10.200.0.2
# Worker-local checkout path. Blank mirrors the head path; WORKER_SCRIPT_DIR
# takes precedence when set.
WORKER_DIR=
WORKER_SCRIPT_DIR=/home/binhdnguyen/ai/DeepSeek-v4-Flash-DSpark-2x-DGX-Spark
MASTER_ADDR=10.200.0.1
MASTER_PORT=25000
NODE_RANK=0
HEADLESS=

# RoCE rail 0
NCCL_IB_HCA=rocep1s0f1
NCCL_SOCKET_IFNAME=enp1s0f1np1
TP_SOCKET_IFNAME=enp1s0f1np1
GLOO_SOCKET_IFNAME=enp1s0f1np1
# NCCL_IB_GID_INDEX=5  # unpinned 2026-07-23: worker RoCEv2 GID moved to idx6 after head reboot; let NCCL auto-detect
NCCL_CROSS_NIC=1

# Per-node distributed addresses
VLLM_HOST_IP=10.200.0.1
WORKER_VLLM_HOST_IP=10.200.0.2

# Cache and model
HF_CACHE=/home/binhdnguyen/ai/huggingface
WORKER_HF_CACHE=/home/binhdnguyen/ai/huggingface
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# Upstream recipe value. Inert while HF_HUB_OFFLINE=1; set 0 to re-enable Xet
# chunked transfer if this profile ever has to re-download weights.
HF_HUB_DISABLE_XET=1
HF_DOWNLOAD_WORKERS=8
DSPARK_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
SERVED_MODEL_NAME="deepseek-v4-flash-0731 deepseek-v4-flash-dspark"
DSPARK_ENCODING_FILE=
VLLM_HOST=0.0.0.0
VLLM_PORT=8888

# Runtime
DSPARK_VLLM_IMAGE=ghcr.io/anemll/dspark-vllm-gx10:0.1.1
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=6
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.80
# Checkpoint dspark_block_size is 5; upstream requires k >= 5.
MTP_NUM_TOKENS=5
# Default reasoning mode: off, low, high, or max. "low" is DeepSeek V4's
# base thinking mode (no extra effort prefix); request-level overrides still win.
DEFAULT_THINKING=low
# Keep regular CUDA graphs; Anemll auto-enables the slower breakable path
# when this is unset.
VLLM_USE_BREAKABLE_CUDAGRAPH=0

# DSpark and B12X
VLLM_USE_FLASHINFER_SAMPLER=1
VLLM_USE_B12X_MOE=1
VLLM_USE_B12X_WO_PROJECTION=1
VLLM_DSPARK_CONFIDENCE_THRESHOLD=0.0
VLLM_DSPARK_CONFIDENCE_SCHEDULER=off
VLLM_DSPARK_LOCAL_ARGMAX=1
VLLM_DSPARK_REPLICATE_MARKOV_W1=1
VLLM_DSPARK_FUSED_MARKOV_ARGMAX=0
VLLM_DSPARK_GPU_REJECTED_CONTEXT_MASK=1
VLLM_DSPARK_REFERENCE_KV_QUANT_DEQUANT=0
DSPARK_SLOT_CLAMP=1
VLLM_DSPARK_HARDWARE_SCHEDULER_EARLY_STOP=1
VLLM_B12X_W4A16_FORCE_BLOCKS_PER_SM=0
VLLM_B12X_W4A16_FORCE_BLOCKS_MAX_M=16
VLLM_B12X_W4A16_FORCE_TILE_CONFIG=
B12X_W4A16_TC_DECODE=0
VLLM_DSV4_B12X_COMPRESSED_MLA=0
VLLM_DSV4_DSPARK_DEFER_TARGET_CAPTURE=0
VLLM_DSV4_DSPARK_DEFER_TARGET_CAPTURE_EXACT=0

# GB10 runtime
ENABLE_VLLM_GB10_PATCH=0
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
VLLM_TRITON_MLA_SPARSE=1
VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=256
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0
VLLM_SKIP_INIT_MEMORY_CHECK=1
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a
CUTE_DSL_ARCH=sm_121a
FLASHINFER_DISABLE_VERSION_CHECK=1
TILELANG_CLEANUP_TEMP_FILES=1
DG_JIT_USE_NVRTC=0
DG_JIT_NVCC_COMPILER=/usr/local/cuda/bin/nvcc
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# NCCL
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_DEBUG=WARN
NCCL_NVLS_ENABLE=0
